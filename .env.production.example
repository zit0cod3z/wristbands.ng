# ============================================================
# WristbandsNG – PRODUCTION Environment Variables
# Copy this to .env on your server and fill in real values
# ============================================================

# ── Core ──────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=GENERATE_A_LONG_RANDOM_KEY_HERE
DEBUG=False
ALLOWED_HOSTS=wristbands.ng,www.wristbands.ng
HTTPS=True

# ── Database ───────────────────────────────────────────────
# For Render: leave as SQLite (default)
# For cPanel: use MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=wristbandsng_db
DB_USER=db_user
DB_PASSWORD=strong_db_password
DB_HOST=localhost
DB_PORT=3306

# ── Email ──────────────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-smtp-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=WristbandsNG <noreply@wristbands.ng>

# ── Security ───────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://wristbands.ng,https://www.wristbands.ng
CORS_ORIGINS=https://wristbands.ng,https://www.wristbands.ng

# ── God Mode Admin ─────────────────────────────────────────
# Change these from defaults before deploying!
GOD_USERNAME=your_secret_username
GOD_PASSWORD=YourVeryStrongPassword@2025!
GOD_EMAIL=your@email.com

# ── Redis (optional — for WebSocket scaling) ───────────────
# REDIS_URL=redis://127.0.0.1:6379/0

# ── Media Storage — Cloudinary (REQUIRED for Render free tier) ────────────
# Without this, images reset on every Render redeploy (broken thumbnails!)
# Sign up FREE at cloudinary.com — 25GB storage + 25GB bandwidth/month free
# After signup: Dashboard → API Keys → copy "API Environment variable"
# It looks like: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# On cPanel/VPS: leave CLOUDINARY_URL blank — Nginx serves /media/ from disk

# ── Media Storage — Cloudinary ─────────────────────────────────────────────
# REQUIRED for Render to prevent broken images after redeploy
# Sign up FREE at https://cloudinary.com (25GB free tier)
# Dashboard → API Keys → copy the full "API environment variable"
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# ── Redis (optional — for WebSocket scaling in production) ─────────────────
# REDIS_URL=redis://127.0.0.1:6379/0
