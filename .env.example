# EventPro Environment Variables – copy to .env and fill in values

SECRET_KEY=your-very-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=eventpro.com,www.eventpro.com,localhost

# Database
# Leave DB_ENGINE unset (or set to django.db.backends.sqlite3) for local dev.
# Switch to mysql for production:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=eventpro_db
# DB_USER=eventpro_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306

# Redis (for caching + Celery)
REDIS_URL=redis://127.0.0.1:6379/0

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=EventPro <noreply@eventpro.com>

# CORS
CORS_ORIGINS=https://eventpro.com,https://www.eventpro.com
